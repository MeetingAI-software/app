222NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=
BOT_PROVIDER=fake
RECALL_API_KEY=
RECALL_BASE_URL=
RECALL_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=
MONTHLY_CAP_SECONDS=14400
MAX_MEETING_SECONDS=3600
MAX_CONCURRENT_BOTS=1
# --- Day 2 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_MS=60000
MAX_TRANSCRIPT_CHARS=180000
DOC_PROVIDER=fake                  # 'fake' | 'claude' | 'gemini'
WEB_ORIGIN=http://localhost:3001
# --- Day 3: in-room recording + chat ---
ASSEMBLYAI_API_KEY=
TRANSCRIPTION_PROVIDER=fake        # 'fake' | 'assemblyai'
TRANSCRIPTION_WEBHOOK_SECRET=      # shared secret checked on POST /webhooks/transcription
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # storage access, server-side only — NEVER in apps/web
MAX_CHAT_QUESTIONS_PER_MEETING=20
MAX_UPLOAD_MB=200                  # MB approximates the per-meeting cap (duration unknown pre-transcription)
CHAT_PROVIDER=fake                 # 'fake' | 'claude' | 'gemini'

# --- Day 5: accounts + sessions ---
SESSION_TTL_DAYS=30                # session cookie lifetime (days); ADMIN_API_KEY is retired

# --- Day 6: observability ---
SENTRY_DSN=                        # optional; error monitoring is a no-op when unset (dev stays clean)

# --- Day 7: Gemini provider (behind the existing chat/document ports) ---
GEMINI_API_KEY=                    # required only if CHAT_PROVIDER or DOC_PROVIDER is 'gemini'
GEMINI_CHAT_MODEL=                 # e.g. gemini-2.5-flash (fast/cheap) — set a real id from Google's docs
GEMINI_DOC_MODEL=                  # e.g. gemini-2.5-pro (stronger) — set a real id from Google's docs

