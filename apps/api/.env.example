NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The local container from docker-compose.yml. A NON-LOCAL host here is refused at boot when there
# is a TTY — the API runs the audio-deleting sweep job on boot and serves account deletion, so
# "started against production by accident" is data loss that has already happened, not a mistake you
# get to undo. Break glass with ALLOW_REMOTE_DB=yes; migrations use ALLOW_PRODUCTION_MIGRATION=yes.
# See docs/local-development.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meetingai_dev
# 'fake' | 'recall'. Setting 'recall' makes all the RECALL_*/PUBLIC_WEBHOOK vars below
# required at boot.
BOT_PROVIDER=fake
# Dashboard → Developers → API Keys & Secrets. Keys are region-specific.
RECALL_API_KEY=
# Region base URL — regions are separate deployments and resources do not cross over.
# https://eu-central-1.recall.ai | us-east-1 | us-west-2 | ap-northeast-1
RECALL_BASE_URL=
# The workspace SECRET (starts with whsec_), not the API key. Same dashboard page.
RECALL_WEBHOOK_SECRET=
# Publicly reachable https origin the provider posts webhooks to, e.g. an ngrok URL.
# Must match the endpoint registered in the dashboard. localhost is rejected at boot.
PUBLIC_WEBHOOK_URL=
# --- Live transcription ---
# Set to 'false' to stop configuring realtime_endpoints on new bots (post-call transcripts
# keep working). Anything other than 'true'/'false' is rejected at boot.
LIVE_TRANSCRIPT_ENABLED=true
# Shared secret for POST /webhooks/recall/live. Recall's per-bot realtime endpoints are not
# Svix-signed, so they authenticate with this token in the query string. Generate with:
#   openssl rand -hex 32
RECALL_LIVE_WEBHOOK_TOKEN=
MONTHLY_CAP_SECONDS=14400
MAX_MEETING_SECONDS=3600
MAX_CONCURRENT_BOTS=1
# --- Day 2 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_MS=60000
MAX_TRANSCRIPT_CHARS=180000
DOC_PROVIDER=fake                  # 'fake' | 'claude' | 'gemini'
# Public frontend origin. Used for email verification links, OAuth redirects, the CORS allow-list
# and the mutating-request origin check — the last two compare it with `===`, so in production it
# must match what the browser actually sends, byte for byte (no trailing slash, and keep the
# `www.` if the apex redirects there). A localhost value is rejected when NODE_ENV=production.
WEB_ORIGIN=http://localhost:3001
# 'log' prints links locally; 'resend' sends real transactional emails.
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Example after domain verification: Syncmemos <verify@updates.your-domain.com>
RESEND_FROM=
# Global cap on verification emails per rolling 24h — the durable backstop the in-memory route
# limiters cannot be: it survives restarts and is indifferent to IP rotation. Sits well below
# Resend's free-plan hard block of 100/day, and lives in env so it can be raised from the dashboard
# without a deploy.
EMAIL_DAILY_SEND_BUDGET=30
# --- Day 3: in-room recording + chat ---
# Fail-closed operational switch. Keep false until the production requirements below have been
# verified. When true in production, startup requires AssemblyAI, the exact EU endpoint, an API key,
# webhook secret, and complete Supabase configuration.
IN_ROOM_RECORDING_ENABLED=false
ASSEMBLYAI_API_KEY=
# Endpoint selection alone does not verify account provisioning, processing region, or retention.
# Keep the feature disabled until those external facts have been verified for the production account.
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
TRANSCRIPTION_PROVIDER=fake        # 'fake' | 'assemblyai'
TRANSCRIPTION_WEBHOOK_SECRET=      # shared secret checked on POST /webhooks/transcription
# Leave BOTH blank for local development. They are optional in the schema, and the storage adapter
# throws "Supabase storage is not configured" on use — so local upload flows fail loudly instead of
# quietly writing to, and deleting from, the live audio bucket. Uploads are the one flow you cannot
# exercise locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=         # storage access, server-side only — NEVER in apps/web
MAX_CHAT_QUESTIONS_PER_MEETING=20
MAX_UPLOAD_MB=200                  # MB approximates the per-meeting cap (duration unknown pre-transcription)
CHAT_PROVIDER=fake                 # 'fake' | 'claude' | 'gemini'
CHAT_TIMEOUT_MS=30000              # chat has someone watching a spinner — shorter than CLAUDE_TIMEOUT_MS

# --- Day 5: accounts + sessions ---
SESSION_TTL_DAYS=30                # session cookie lifetime (days); ADMIN_API_KEY is retired

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required once GOOGLE_CLIENT_ID is set, and must be registered verbatim as an Authorized
# redirect URI in the Google Cloud console. Points at the API host, not the web origin.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Day 6: observability ---
SENTRY_DSN=                        # optional; error monitoring is a no-op when unset (dev stays clean)
GIT_COMMIT=                        # set by the deploy pipeline, echoed by /healthz; blank locally

# --- Day 7: Gemini provider (behind the existing chat/document ports) ---
GEMINI_API_KEY=                    # required only if CHAT_PROVIDER or DOC_PROVIDER is 'gemini'
GEMINI_CHAT_MODEL=                 # e.g. gemini-2.5-flash (fast/cheap) — set a real id from Google's docs
GEMINI_DOC_MODEL=                  # e.g. gemini-2.5-pro (stronger) — set a real id from Google's docs

# --- Paddle Billing ---
PADDLE_ENV=sandbox
# Keep false except during an explicitly controlled test or launch window.
BILLING_MUTATIONS_ENABLED=false
# Production requires a pdl_live_apikey_ key, webhook secret, and all four Live price IDs.
# Remove PADDLE_SANDBOX_API_KEY entirely before setting PADDLE_ENV=production. The API then checks
# the Live catalog against Paddle before it starts listening; failed verification stops startup.
PADDLE_API_KEY=pdl_sdbx_apikey_your_key
PADDLE_SANDBOX_API_KEY=            # sandbox-only fallback; production never falls back to it
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_your_endpoint_secret
NEXT_PUBLIC_PADDLE_SOLO_MONTHLY_PRICE_ID=pri_solo_monthly
NEXT_PUBLIC_PADDLE_SOLO_ANNUAL_PRICE_ID=pri_solo_annual
NEXT_PUBLIC_PADDLE_TEAM_MONTHLY_PRICE_ID=pri_team_monthly
NEXT_PUBLIC_PADDLE_TEAM_ANNUAL_PRICE_ID=pri_team_annual
