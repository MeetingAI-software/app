{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "billing:check": "npm run build && node dist/scripts/paddle-readiness.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/adapters/db/migrate.ts",
    "db:seed": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/genai": "^2.18.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "postgres": "^3.4.4",
    "resend": "^6.22.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  }
}
