# `railway up` uploads this directory as the build context. Everything listed here stays out.

# The important one. config/env.ts calls dotenv.config({ override: true }), so a .env file inside
# the image beats Railway's injected variables outright — production would silently boot with the
# dev WEB_ORIGIN and the local webhook tunnel, which is the exact outage we just fixed.
.env
.env.*
!.env.example

# Native modules (argon2) are built for this machine's platform; the image must compile its own.
node_modules

# Build output is regenerated by the Nixpacks build step.
dist
.next

.git
